# AegisNet Environment Configuration
# Copy this file to .env and adjust values for your environment

# Application
APP_NAME=AegisNet
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database (SQLite by default; supports postgresql+psycopg2://user:pass@host:5432/aegisnet)
DATABASE_URL=sqlite:///./data/aegisnet.db

# Security & Rate Limiting
API_KEY_HEADER=X-AegisNet-Key
OPTIONAL_API_KEY=
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_REQUESTS_PER_MINUTE=240

# Model & Detection Defaults
MODEL_ARTIFACTS_DIR=./artifacts
DATA_DIR=./data
DEFAULT_CONFIDENCE_THRESHOLD=0.70
DEFAULT_ENTROPY_THRESHOLD=0.55
DEFAULT_ANOMALY_PERCENTILE=95.0
RANDOM_SEED=42

# Optional Fireworks AI Threat Analyst Briefing Integration
# Leave FIREWORKS_API_KEY empty to run 100% offline with local deterministic explanations
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1/chat/completions
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
